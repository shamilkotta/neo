{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["bun"]
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "hosts/cf",
    "apps/web/src",
    "apps/web/vite.config.ts",
    "**/dist"
  ]
}
