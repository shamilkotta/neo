{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "neo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "durable_objects": {
    "bindings": [{ "name": "INSTANCE", "class_name": "InstanceDO" }],
  },
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "neo-blobs" }],
  "vars": { "NEO_TEST": "0" },
  "secrets": { "required": ["NEO_MASTER_KEY", "NEO_TOKEN"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InstanceDO"] }],
}
