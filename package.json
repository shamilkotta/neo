{
  "name": "neo",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "workspaces": [
    "kernel",
    "hosts/*",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "neo": "bun run apps/cli/src/cli.ts",
    "build:web": "bun run --filter @neo/web build",
    "dev:web": "bun run --filter @neo/web dev",
    "dev:cf": "bun run --filter @neo/cf dev",
    "deploy:cf": "bun run --filter @neo/cf deploy",
    "types:cf": "bun run --filter @neo/cf types",
    "lint": "bun lint --no-script",
    "check": "bun check --no-script && bun check --no-script -p hosts/cf && bun check --no-script -p apps/web",
    "test": "bun run build:web && bun test e2e",
    "test:cf": "NEO_CF_URL=http://localhost:8799 bun test e2e"
  },
  "devDependencies": {
    "@neo/client": "workspace:*",
    "@neo/kernel": "workspace:*",
    "@types/bun": "^1.4.4",
    "bun": "1.4.5-canary.20261120.1",
    "typebox": "1.3.27",
    "typescript": "5"
  }
}
